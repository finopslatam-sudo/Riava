# ─── App ───────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-very-long-random-string-at-least-64-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database ──────────────────────────────────────────
DB_PASSWORD=your_postgres_password
DATABASE_URL=postgresql+asyncpg://riava:your_postgres_password@localhost:5432/riava_leads
# For sync operations (alembic):
SYNC_DATABASE_URL=postgresql://riava:your_postgres_password@localhost:5432/riava_leads

# ─── Redis ─────────────────────────────────────────────
REDIS_PASSWORD=your_redis_password
REDIS_URL=redis://:your_redis_password@localhost:6379/0

# ─── Encryption (tokens at rest) ───────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here

# ─── Meta / Facebook ──────────────────────────────────
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_VERIFY_TOKEN=your_webhook_verify_token
META_WEBHOOK_SECRET=your_webhook_app_secret_for_signature_check
META_API_VERSION=v21.0
META_REDIRECT_URI=http://localhost:8000/api/v1/meta/oauth/callback

# ─── WhatsApp Business ─────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_BUSINESS_ID=

# ─── Email ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAILS_FROM_NAME=Riava Leads
EMAILS_FROM_EMAIL=noreply@riava.cl

# ─── CORS ──────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Rate Limiting ─────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10

# ─── Celery ─────────────────────────────────────────────
CELERY_BROKER_URL=redis://:your_redis_password@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:your_redis_password@localhost:6379/2
